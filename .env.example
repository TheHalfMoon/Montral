# apps/api/.dev.vars (local) — in production use `wrangler secret put <NAME>`
DATABASE_URL=postgres://user:pass@localhost:5432/montral_dev   # local only; production uses the HYPERDRIVE binding
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4321    # public origin of the web app (API is proxied at /api)
WEB_ORIGIN=http://localhost:4321
CRON_SECRET=change-me                    # lets an external scheduler hit POST /internal/run-checks
# "Sign in with GitHub": create a GitHub OAuth App whose callback URL is ${BETTER_AUTH_URL}/api/auth/callback/github
# and set both values; without them the GitHub button is hidden (check GET /api/config -> auth.github). Docs: /docs/self-host#github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email (invitations, password reset, email alert channel, status page subscriptions).
# Local dev logs emails to the console. In production set EMAIL_FROM (Cloudflare Email Sending binding `EMAIL`).
# EMAIL_FROM=alerts@your-domain.com

# Close registration once you have your own account; people with a pending invitation can still join.
# DISABLE_SIGNUP=true

# Cloudflare Turnstile on the sign-up form: set both keys to enable it. Cloudflare's test keys for local dev:
# site 1x00000000000000000000AA (always passes), secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# LEGAL_LINKS=true

# iOS push notifications (optional): an APNs Auth Key (.p8) and the app's ids. All four must be set. Use \n for line breaks
# in APNS_KEY. The key is tied to the app's bundle id, see /docs/self-host#apns.
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=

# Local dev: monitors on localhost / private addresses are refused unless this is true.
# ALLOW_PRIVATE_TARGETS=true

# URLs (comma-separated) a failed check fetches to tell "the target is down" from "this server is offline".
# Unset: three well-known public URLs. Empty (SELFCHECK_URLS=): no self-check.
# SELFCHECK_URLS=


# Montral billing is disabled unless ALL of these are configured.
# Test-mode only. Never commit real values.
# MONTRAL_BILLING_ENABLED=true
# MONTRAL_BILLING_MODE=test
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_PRO=
# LEMONSQUEEZY_VARIANT_BUSINESS=

# Montral meter remains disabled until explicit zero-cost/private testing opt-in.
# MONTRAL_METERING_ENABLED=true
# STAGED / OFF. Do not enable without authenticated operator/provider review.
# MONTRAL_RECONCILIATION_ENABLED=false
# Optional emergency pause: stop NEW monthly report claims only. Does NOT stop in-flight emails.
# MONTRAL_MONTHLY_REPORTS_PAUSED=false
