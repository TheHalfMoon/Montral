# Used by apps/probe/docker-compose.yml. Copy to .env.

# Required. A long random string; the same value as PROBE_SECRET on the API.  openssl rand -hex 32
PROBE_SECRET=

# Optional rollover key accepted by the probe during a staged rotation; remove promptly after API cutover.
# PROBE_PREVIOUS_SECRET=
# Required together with the previous secret. Unambiguous UTC deadline, for example 2027-01-01T00:00:00Z.
# PROBE_PREVIOUS_SECRET_EXPIRES_AT=

# Optional label (shown by the health check), e.g. sao-paulo
PROBE_REGION=

# Set with `docker compose --profile tls up -d` to get HTTPS from the bundled Caddy
# PROBE_DOMAIN=probe.example.com

# Optional. Image to run (default montral-probe:local) and the host port (loopback only by default)
# PROBE_IMAGE=
# PROBE_PORT=8787
# PROBE_BIND=127.0.0.1

# Optional. Same meaning as on the API. Private targets stay refused unless you turn this on, and then this probe can
# reach everything its network can: only do it for a probe that lives inside the network you want to watch.
# CHECK_USER_AGENT=
# ALLOW_PRIVATE_TARGETS=true
