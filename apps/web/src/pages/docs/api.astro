---
import Doc from "../../layouts/Doc.astro";

type Ep = { m: "GET" | "POST" | "PUT" | "PATCH" | "DELETE"; p: string; en: string; zh: string; req?: string; res?: string };
type Group = { id: string; en: string; zh: string; noteEn?: string; noteZh?: string; eps: Ep[] };

const monitorFields = `name           string, 1-120 chars (required)
type           "http" | "tcp" | "websocket" | "dns" | "heartbeat" | "postgres" | "mysql" | "redis" | "domain" | "certificate" | "ping"   (default "http"; cannot be changed later)
target         string, max 2048   (URL for http, ws:// or wss:// URL for websocket, host:port for tcp/postgres/mysql/redis, hostname for dns, registered domain for domain, host or host:port for certificate (default port 443), hostname or IP address for ping)
domainExpiryWarnDays integer 1-365  domain and certificate: fail when the expiry date is this many days away or closer (default 30)
method         "GET" | "HEAD" | "POST" | "PUT" | "PATCH" | "DELETE" | "OPTIONS"
requestBody    string | null (max 16384 UTF-8 bytes; no body for GET/HEAD)
expectedStatus integer 100-599                               (default 200)
intervalSec    integer 60-86400                              (default 60; domain and certificate: bounded to 3600-86400)
timeoutMs      integer 1000-30000                            (default 10000)
failureThreshold integer 1-10  consecutive failures before an incident opens (default 3)
recoveryThreshold integer 1-10 successful runs or heartbeat pings before recovering from down (default 1)
regions        string[], ids from GET /regions                 (default ["auto"]; http, tcp and websocket monitors only)
keyword        string | null, max 500                        (default null)
keywordMode    "contains" | "absent"                         (default "contains")
jsonPath       string | null, max 200  http only: one value of the JSON response body, e.g. status, $.data.items[0].state, ["key with space"]; dot keys, [index] and ["quoted key"], at most 32 segments (default null = no JSON assertion; skipped for HEAD)
jsonMatch      "equals" | "contains" | "exists"  (default "equals"; exists passes for any value, null included)
jsonExpected   string | null, max 500  required for equals/contains, ignored by exists; strings compare as they are, numbers/booleans/null as JSON ("42" matches 42, "true" matches true)
expectedLocation string | null, max 2048  with a 301/302/303/307/308 expectedStatus: the redirect is not followed; Location must equal this URL or path (default null = any)
headers        { [name: string]: string }  http, or the websocket handshake (default {})
wsMessage      string | null, max 2000  websocket: text sent once connected; a message must come back within timeoutMs (default null = handshake only; not a secret)
dnsRecordType  "A" | "AAAA" | "CNAME" | "MX" | "TXT" | "NS" (default "A")
dnsExpectedValue string | null, max 2000 (default null = any answer of selected type)
dnsMatchMode   "exact" | "contains" (default "exact")
graceSec       integer 0-86400, heartbeat grace period       (default 0)
channelIds     uuid[], max 50                                (default [])
tags           string[], max 20 items of up to 32 chars      (default [])
slowThresholdMs integer 100-60000, latency above this marks the monitor "degraded" (default 1500)
slowAlertAfter integer 0-20, open a latency incident after this many consecutive slow checks; 0 = never (default 0)
dependsOnMonitorId uuid | null, another monitor of the same project; while it is down this one opens no incidents and sends no alerts (default null; never itself or a cycle)
minRegionsFailing integer 0-20, several regions: how many must fail before the monitor goes down; 0 = a majority of those that answered (default 0)
escalationPolicyId uuid | null, a workspace-wide or this project's escalation policy that replaces the project's escalation levels for this monitor (default null)`;

const groups: Group[] = [
  {
    id: "monitors", en: "Monitors", zh: "监控项",
    noteEn: "DNS checks query Cloudflare's public DNS-over-HTTPS resolver from auto. At least one answer of the selected record type must exist and match the optional expected value. Unicode targets and DNS hostnames use IDNA. Exact CNAME/NS and MX matching ignores hostname case and trailing dots; IPv6 forms are normalized. Exact IPv4 values trim surrounding whitespace and normalize dotted decimal octets; DNS assertion fields are ignored on other monitor types. Substring matches trim the expected text and ignore case, except for TXT; other exact values are case-sensitive. TXT uses DNS presentation including quotes; MX includes priority (10 mail.example.com.). NXDOMAIN, no matching records, truncated answers and resolver errors fail the check. Existing DNS monitors default to A with no value assertion, so a name that only has a CNAME (no address) or no A record now fails, where any answer used to pass. Recovery threshold controls outage recovery only. Each successful multi-region vote counts once; each accepted heartbeat ping counts once, even when several arrive close together, so a burst of pings can satisfy the threshold. A check run by hand on a paused monitor changes nothing about its status. A failed check resets the streak, including failures suppressed by maintenance. Inconclusive checks do not count. Slow successful responses count and can recover to degraded; latency-only recovery is unchanged. Pausing or resuming resets the success streak. Raw check results and uptime statistics are still recorded immediately.",
    noteZh: "DNS 检测从 auto 位置请求 Cloudflare 公共 DNS-over-HTTPS 解析器。必须至少存在一条指定类型的记录，并匹配可选期望值。Unicode 目标及 DNS 域名按 IDNA 规范化。CNAME、NS 和 MX 的完全匹配忽略域名大小写及末尾的点；IPv6 地址会规范化。IPv4 完全匹配忽略首尾空白并规范化点分十进制数值；其他监控类型会忽略 DNS 断言字段。包含匹配会去掉期望值首尾空白，且除 TXT 外忽略大小写；其他完全匹配区分大小写。TXT 使用带引号的 DNS 表示形式；MX 包含优先级（10 mail.example.com.）。域名不存在、无符合类型的记录、响应截断或解析器错误均判定为失败。已有 DNS 监控默认检测 A 记录，不校验具体值；因此只有 CNAME（没有地址）或没有 A 记录的域名现在会判定为失败，而此前任何应答都算通过。恢复阈值仅控制宕机恢复。每轮成功的多区域投票计一次，每次接受的心跳计一次，即使多次心跳间隔很短也各自计数，因此连续快速的心跳可以满足阈值。对已暂停的监控手动执行检测不会改变其状态。失败检测会清零连续成功次数，包括维护期内被抑制的失败；无法判定的检测不计数。慢响应只要成功也计入，可能恢复为性能下降；单独的延迟事故恢复逻辑不变。暂停或恢复检测会清零成功次数。原始检测结果和可用率统计仍即时记录。",
    eps: [
      { m: "GET", p: "/monitors", en: "List the project's monitors, with 24-hour uptime, average latency and a latency sparkline.", zh: "列出当前项目的监控项，附带 24 小时可用率、平均延迟和延迟走势。",
        res: `[{ id, name, type, target, method, expectedStatus, intervalSec, timeoutMs, failureThreshold, regions,\n   status, consecutiveFailures, lastCheckedAt, nextCheckAt, paused, heartbeatToken, keyword, keywordMode,\n   headers, graceSec, ..., uptime24h, avgLatency24h, spark }]` },
      { m: "POST", p: "/monitors", en: "Create a monitor. Omitted fields take their defaults. Returns 201 with the monitor; heartbeat monitors get a heartbeatToken.", zh: "创建监控项，省略的字段使用默认值。返回 201 和监控项；心跳类型会生成 heartbeatToken。", req: monitorFields },
      { m: "GET", p: "/monitors/export", en: "Download the project's monitors as JSON ({ version, exportedAt, monitors }). Request headers are included, so treat the file as sensitive.", zh: "以 JSON 导出当前项目的监控项（{ version, exportedAt, monitors }）。文件包含请求头，请当作敏感文件保管。" },
      { m: "POST", p: "/monitors/import/preview", en: "Validate an import without creating monitors. Returns per-row warnings, duplicate identities, plan capacity and destination.", zh: "验证导入但不创建监控项，返回逐条警告、重复标识、套餐容量和目标信息。" },
      { m: "POST", p: "/monitors/import", en: "Create monitors from a JSON array (or an object with a monitors array), up to 500 per call. Accepts our export plus common aliases from other tools (name/friendly_name, target/url/hostname, interval in seconds, type https/keyword/port). Invalid items are skipped and reported. Returns 201 when records are created, 200 for an idempotent duplicate-only retry, or 400 when every row is invalid; responses include created, duplicates, skipped and report. Request bodies are limited to 4 MiB.", zh: "从 JSON 数组（或含 monitors 数组的对象）批量创建监控项，单次最多 500 个。支持本产品的导出格式，以及其他工具常见的字段别名（name/friendly_name、target/url/hostname、interval 秒、type https/keyword/port）。无效项会被跳过并返回。创建新项时返回 201，仅包含重复项的幂等重试返回 200，所有记录无效时返回 400；响应包含 created、duplicates、skipped 和 report。请求体最大为 4 MiB。", req: `{ "monitors": [ { "name": "API", "type": "http", "target": "https://api.example.com", "tags": ["prod"] } ] }`, res: `{ created: 1, skipped: [] }` },
      { m: "GET", p: "/monitors/:id", en: "One monitor with its last 120 check results, last 5 incidents and stats.", zh: "获取单个监控项，含最近 120 条检测结果、最近 5 个事件和统计数据。",
        res: `{ ...monitor, results: [{ id, region, ok, statusCode, latencyMs, error, checkedAt }],\n  incidents: [...], stats: { uptime24h, uptime7d, avg24h, p95 },\n  regionStats: [{ region, checks24h, uptime24h, avgLatency24h, last }] }` },
      { m: "GET", p: "/monitors/:id/time-coverage?days=7", en: "Authenticated 7- or 30-day UTC time coverage (days defaults to 7). Returns from, to, totalMs, states (up/down/degraded/paused/unknown milliseconds), observedMaintenanceMs and policy. Uses monitor project permissions; responses are not cached. Missing observations are unknown; maintenance is included, not subtracted. This is inferred observation coverage, not exact outage duration or an SLA.", zh: "需认证的 7 天或 30 天 UTC 时间覆盖报告（days 默认 7）。返回 from、to、totalMs、states（正常/缓慢/宕机/暂停/未知的毫秒数）、observedMaintenanceMs 和 policy。沿用监控项的项目权限，响应不缓存。缺失观测记为未知，维护时间包含在内，不从分母扣除；这是观测推断覆盖，不是精确停机时长或 SLA。" },
      { m: "PATCH", p: "/monitors/:id", en: "Update the named fields only (same fields as create, except type). Also accepts paused (boolean) to pause or resume. At least one field is required.", zh: "仅更新传入的字段（与创建相同，但不含 type），另可传 paused（布尔）暂停或恢复。至少需要一个字段。", req: `any of the create fields except "type", plus:\npaused  boolean` },
      { m: "DELETE", p: "/monitors/:id", en: "Delete a monitor and its results. Returns 204.", zh: "删除监控项及其检测结果。返回 204。" },
      { m: "POST", p: "/monitors/:id/check", en: "Run a check immediately from the monitor's own regions and record it. Returns { ok: true }. With a region, sends one request from that region instead, as a diagnostic: the result is returned and nothing is recorded or changes the monitor's status. It uses one check of your allowance. 502 probe_unreachable when the region could not be reached. 429 with Retry-After: manual_check_rate_limited after 60 manual checks per workspace in 10 minutes, or manual_check_busy when this server already runs 32 manual checks.", zh: "立即按监控项自己的区域执行一次检测并记录，返回 { ok: true }。传入 region 时，改为只从该区域发出一次请求用于诊断：返回结果，但不记录，也不会改变监控状态，消耗 1 次检查额度。区域无法连通时返回 502 probe_unreachable。每个工作区 10 分钟内超过 60 次手动检查返回 429 manual_check_rate_limited，服务器已在运行 32 个手动检查时返回 429 manual_check_busy（均带 Retry-After）。", req: `(no body)   run from the monitor's regions and record the result\n{ "region": "eu-central" }   one-off request from that region`, res: `{ ok: true }\n{ ok: true, region: "eu-central", result: { ok, statusCode, latencyMs, error } }` },
    ],
  },
  {
    id: "regions", en: "Regions", zh: "检测区域",
    noteEn: "A monitor checks from its own location (auto) unless regions says otherwise; list regions only for http, tcp and websocket monitors. With several regions a run is down when most of the regions that answered failed, so one region's bad route does not page you. Each region counts as one check of your allowance. Errors: 400 unknown_region, 400 regions_not_supported (other monitor types), 402 regions_not_allowed (more regions than the plan allows).",
    noteZh: "监控项默认从服务自身所在位置（auto）检测，仅当设置 regions 时才走多区域，且只适用于 http、tcp 与 websocket 类型。多区域时，只有多数应答的区域都失败才判定为故障，单个区域的线路问题不会触发告警。每个区域各计一次检查额度。错误：400 unknown_region、400 regions_not_supported（其他类型）、402 regions_not_allowed（超出套餐允许的区域数）。",
    eps: [
      { m: "GET", p: "/regions", en: "The regions this deployment can check from, the monitor types that support them and how many one monitor may list (null: no limit, which is always the case when self-hosting).", zh: "当前部署可用的检测区域、支持区域检测的监控类型，以及单个监控项最多可选的区域数（null 表示不限，自部署始终不限）。",
        res: `{ regions: [{ id: "auto", name: "Auto" }, { id: "us-east", name: "US East (Virginia)" }, ...],\n  types: ["http", "tcp", "websocket"], maxPerMonitor: 3 }   // null: no limit` },
    ],
  },
  {
    id: "incidents", en: "Incidents", zh: "事件",
    eps: [
      { m: "GET", p: "/incidents", en: "The latest 100 incidents of the project, newest first. Pass q to filter by incident number (INC-12 or 12) or by a word in the title.", zh: "当前项目最新的 100 个事件，按时间倒序。传入 q 可按事件编号（INC-12 或 12）或标题关键词过滤。",
        res: `[{ id, number, monitorId, title, status, severity, auto, assigneeId, startedAt, acknowledgedAt, resolvedAt, rootCause, postmortem, monitorName }]\nnumber is sequential inside the project: INC-<number>` },
      { m: "POST", p: "/incidents", en: "Open an incident manually. Returns 201.", zh: "手动创建事件。返回 201。", req: `title      string, 1-200 (required)\nbody       string, max 4000   first update, optional\nseverity   "minor" | "major"   (default "major")\nmonitorId  uuid | null        optional\nvisibility "public" | "internal"   of the first update (default "public")` },
      { m: "GET", p: "/incidents/:id", en: "An incident with its updates (internal ones included), monitor, assignee and up to 8 failing checks.", zh: "获取事件详情，含更新记录（包括内部更新）、监控项、负责人和最多 8 条失败检测。",
        res: `{ ...incident, updates: [{ id, status, body, visibility, authorId, createdAt }], monitor, assignee, checks }` },
      { m: "PATCH", p: "/incidents/:id", en: "Set or clear the root cause and the postmortem. A field left out stays as it is; null or an empty string clears it. Both stay private until you send publishPostmortem: true; then they are shown on the public status page once the incident is resolved (false takes them back). Returns the incident.", zh: "设置或清除根因和复盘。未传的字段保持不变，传 null 或空字符串则清除。传 publishPostmortem: true 之前两者保持私有；发布后，事件解决时才会显示在公开状态页上（传 false 可撤回）。返回该事件。", req: `rootCause   string | null, max 500    short cause\npostmortem  string | null, max 20000  markdown or plain text\npublishPostmortem  boolean   show both on the public page once resolved (sets postmortemPublishedAt)` },
      { m: "POST", p: "/incidents/:id/updates", en: "Post an update and set the incident status. A public update shows on status pages and is emailed to subscribers; an internal one is visible to your team only and sends nothing. Status \"resolved\" closes the incident and must be public (400 for an internal one), because subscribers are mailed about it. Returns 201.", zh: "发布更新并设置事件状态。公开更新会显示在状态页并邮件通知订阅者；内部更新仅团队可见，不会发送任何通知。状态为 \"resolved\" 时事件关闭，且必须是公开更新（内部更新返回 400），因为订阅者会收到邮件。返回 201。", req: `status      "investigating" | "identified" | "monitoring" | "resolved"\nbody        string, 1-4000\nvisibility  "public" | "internal"   (default "public")` },
      { m: "POST", p: "/incidents/:id/ack", en: "Acknowledge an incident: reminders and escalation stop, and the incident is assigned to the caller unless someone already owns it. Returns the incident.", zh: "确认事件：提醒和升级随即停止；若事件尚无负责人，则指派给调用者。返回该事件。" },
    ],
  },
  {
    id: "channels", en: "Channels", zh: "告警渠道",
    noteEn: "config depends on type: email { to }, slack { url }, discord { url }, teams { url }, ntfy { url, topic, token?, priority? (1–5 as a string) }, googlechat { url } (https://chat.googleapis.com/v1/spaces/…/messages?key=…&token=…), mattermost { url } (…/hooks/<id>), gotify { url (https server URL), token }, pushover { token, userKey, device? }, lark { url, secret? }, webhook { url }, telegram { botToken, chatId }, pagerduty { routingKey }. Channel configs contain secrets and are returned as stored. A channel with autoEnable is added to the channelIds of every monitor created afterwards (in its project, or in any project for a workspace-wide channel), on top of any ids given; a monitor whose channelIds is empty alerts every enabled channel.",
    noteZh: "config 取决于 type：email { to }、slack { url }、discord { url }、teams { url }、ntfy { url, topic, token?, priority?（字符串 1–5） }、googlechat { url }（https://chat.googleapis.com/v1/spaces/…/messages?key=…&token=…）、mattermost { url }（…/hooks/<id>）、gotify { url（https 服务器地址）, token }、pushover { token, userKey, device? }、lark { url, secret? }、webhook { url }、telegram { botToken, chatId }、pagerduty { routingKey }。渠道配置含敏感信息，按存储内容原样返回。",
    eps: [
      { m: "GET", p: "/channels", en: "List the alert channels available in the project: workspace-wide ones (projectId null) and the project's own.", zh: "列出当前项目可用的告警渠道：工作区级渠道（projectId 为 null）和项目自己的渠道。", res: `[{ id, type, name, config, enabled, autoEnable, createdAt, projectId }]` },
      { m: "POST", p: "/channels", en: "Create a channel. Returns 201.", zh: "创建渠道。返回 201。", req: `type     "email" | "slack" | "telegram" | "webhook" | "pagerduty" | "lark" | "discord" | "teams" | "ntfy" | "googlechat" | "mattermost" | "gotify" | "pushover"\nname     string, 1-80\nconfig   object   (default {})\nenabled  boolean  (default true)\nautoEnable  boolean  (default false)  new monitors start out alerting this channel\nscope    "workspace" | "project"  (default "workspace"; a project-limited key always creates a project channel)` },
      { m: "PATCH", p: "/channels/:id", en: "Update name, enabled, autoEnable or config.", zh: "更新名称、启用状态、autoEnable 或配置。", req: `name     string, 1-80\nenabled  boolean\nautoEnable  boolean\nconfig   object` },
      { m: "POST", p: "/channels/:id/test", en: "Send a test message. Returns { ok: true }, or 502 with a redacted delivery category (never raw provider diagnostics).", zh: "发送测试消息。成功返回 { ok: true }；失败返回 502 和脱敏后的错误类别，不暴露服务商原始诊断。" },
      { m: "DELETE", p: "/channels/:id", en: "Delete a channel. Returns 204, or 409 (code \"channel_in_use\", with the monitors) while a monitor still lists it in channelIds.", zh: "删除渠道。返回 204；仍有监控在 channelIds 中选用它时返回 409（code 为 \"channel_in_use\"，并附监控列表）。" },
    ],
  },
  {
    id: "status-pages", en: "Status pages", zh: "状态页",
    eps: [
      { m: "GET", p: "/status-pages", en: "List the project's status pages.", zh: "列出当前项目的状态页。", res: `[{ id, slug, title, theme, showLatency, customDomain, customDomainToken, customDomainVerifiedAt, customDomainRecord, externalUrl, hideBranding, uptimeOkPct, uptimeWarnPct, mcpEnabled, maintenanceReminderHours, visibility, hasPassword, accessVersion, createdAt, projectId }]` },
      { m: "POST", p: "/status-pages", en: "Create a status page. The slug must be unused (409 otherwise). Returns 201.", zh: "创建状态页。slug 不能被占用（否则 409）。返回 201。", req: `slug         string, /^[a-z0-9-]{3,40}$/ (required)\ntitle        string, 1-120 (required)\nexternalUrl  string | null, http(s) URL up to 2048 (a link shown beside the title, rel=nofollow)\ntheme        "light" | "dark" | "auto"\nshowLatency  boolean\nhideBranding boolean (hide the Montral mark and "Powered by" line; the header shows the logo of externalUrl via favicon.im; 402 branding_not_allowed when the plan does not include it)\nuptimeOkPct  number 1-100, default 99.9 (uptime bars are green from here)\nuptimeWarnPct number 1-100, default 98 (amber from here, red below; must be lower than uptimeOkPct, 400 otherwise)\nmcpEnabled   boolean, default true (the public read-only MCP tools may read the page; the page, feeds and llms.txt stay public either way)\nmaintenanceReminderHours integer 0-168, default 24 (0 = no reminder email before maintenance)\nvisibility   "public" | "members" | "password", default "public" ("members": only signed-in members of the workspace, or holders of a share link, can open the page and its feeds, badge, llms.txt and subscribe form; everyone else, API keys and agents get 404. "password": members, plus anyone who unlocks it with the page password or a share link; others get 401 { locked: true } without the title or content. Embeds and the public MCP tools stop working for both. Emails: members-only pages reach verified workspace members; password pages also reach subscribers who subscribed under the current access version)\npassword     string 8-200, required when visibility is "password" and no password is set yet; never returned (GET shows hasPassword). Setting a new one signs every outside visitor out.\nmonitorIds   uuid[]\ncomponents   [{ monitorId: uuid, groupName?: string 1-60 }], max 200 (takes precedence over monitorIds)` },
      { m: "GET", p: "/status-pages/:id", en: "A status page with its ordered components.", zh: "获取状态页及其有序组件。", res: `{ ...page, monitorIds: uuid[], components: [{ monitorId, groupName }], branding: { allowed, upgradeUrl? } }` },
      { m: "PATCH", p: "/status-pages/:id", en: "Update title, theme, showLatency or replace the components. Slug cannot be changed. Returns { ok: true }.", zh: "更新标题、主题、延迟显示，或替换组件。slug 不可修改。返回 { ok: true }。", req: `title, theme, showLatency, externalUrl, hideBranding, uptimeOkPct, uptimeWarnPct, mcpEnabled, maintenanceReminderHours, visibility, password, monitorIds, components   (all optional, as in create)` },
      { m: "POST", p: "/status-pages/:id/access/revoke", en: "Sign out everyone outside the workspace (owner or admin): password and share-link cookies stop working at once. Share links themselves keep working; revoke them separately.", zh: "让工作区以外的所有访问者退出（需所有者或管理员）：通过密码或分享链接获得的访问立即失效。分享链接本身仍然有效，需单独撤销。" },
      { m: "GET", p: "/status-pages/:id/share-links", en: "The page's share links, newest first (owner or admin). Tokens are never listed.", zh: "该页面的分享链接，按时间倒序（需所有者或管理员）。不会列出令牌。", res: `[{ id, label, createdAt, expiresAt, revokedAt, lastUsedAt }]` },
      { m: "POST", p: "/status-pages/:id/share-links", en: "Create a share link for a page that is not public (owner or admin; 400 for a public page; at most 50 active per page, 409 beyond). Whoever opens the URL gets access to that page until the link expires or is revoked, without a password or an account. The URL is returned only in this response; only a hash of its token is stored.", zh: "为非公开页面创建分享链接（需所有者或管理员；公开页面返回 400；每页最多 50 个有效链接，超出返回 409）。打开该地址的人无需密码或账号即可访问该页面，直到链接过期或被撤销。地址仅在此响应中返回，服务端只保存其令牌的哈希。", req: `label           string, max 80 (optional)\nexpiresInHours  integer 1-8760, default 168`, res: `{ id, label, expiresAt, url, warning }` },
      { m: "DELETE", p: "/status-pages/:id/share-links/:linkId", en: "Revoke a share link (owner or admin). Anyone using it loses access on their next request. Returns 204.", zh: "撤销分享链接（需所有者或管理员）。使用该链接的人在下一次请求时即失去访问权限。返回 204。" },
      { m: "PUT", p: "/status-pages/:id/domain", en: "Set or replace the page's custom domain (owner or admin; self-hosted Node only, 400 custom_domain_unsupported on Cloudflare Workers). The hostname must be a lowercase FQDN without scheme, port, path, wildcard or IP, at most 253 characters, and not this instance's own host (400 otherwise). It always starts unverified with a new TXT value, even when the name is unchanged. Naming a domain another page holds is allowed: it moves only when this page proves its own TXT record (see verify).", zh: "设置或替换该页面的自定义域名（需所有者或管理员；仅限自托管 Node，Cloudflare Workers 上返回 400 custom_domain_unsupported）。主机名必须是小写的完整域名，不含协议、端口、路径、通配符或 IP，最长 253 个字符，且不能是本实例自己的主机（否则 400）。即使名称不变，也总会以未验证状态和新的 TXT 值开始。可以填写其他页面已持有的域名：只有当本页面证明了自己的 TXT 记录后，域名才会转移（见验证）。", req: `domain   string, e.g. "status.example.com"`, res: `{ customDomain, customDomainVerifiedAt: null, customDomainRecord: { type: "TXT", name: "_montral-challenge.<domain>", value: "montral-verify=…" } }` },
      { m: "POST", p: "/status-pages/:id/domain/verify", en: "Look up the TXT record at _montral-challenge.<domain> now (owner or admin; 30 per page per hour). An exact match marks the domain verified and the Node server starts serving the page there, and clears any failing streak of the scheduled re-checks (status page objects carry customDomainCheckedAt, customDomainFailingSince, customDomainFailures and customDomainCheckError; a withdrawn domain has customDomainVerifiedAt null and keeps its customDomainCheckError); 422 { verified: false, reason: \"missing\" | \"mismatch\" | \"lookup_failed\", error, record } otherwise; a proven record moves the domain here from any page that held it (DNS decides ownership); 409 custom_domain_taken only when a concurrent verification won the race, and 409 without a code when the domain was changed during verification; retry to settle either; 400 without a domain.", zh: "立即查询 _montral-challenge.<domain> 上的 TXT 记录（需所有者或管理员；每页每小时 30 次）。完全匹配时域名标记为已验证，Node 服务器开始在该域名上提供此页面，并清除定期复查的失败记录（状态页对象包含 customDomainCheckedAt、customDomainFailingSince、customDomainFailures 和 customDomainCheckError；被撤销的域名 customDomainVerifiedAt 为 null 并保留 customDomainCheckError）；否则返回 422 { verified: false, reason: \"missing\" | \"mismatch\" | \"lookup_failed\", error, record }；已证明的记录会将域名从原持有页面转移到本页面（由 DNS 决定归属）；仅当并发验证抢先时返回 409 custom_domain_taken，验证期间域名被修改时返回不带 code 的 409，重试即可；未设置域名时返回 400。", res: `{ verified: true, customDomain, customDomainVerifiedAt, customDomainCheckedAt, record }` },
      { m: "DELETE", p: "/status-pages/:id/domain", en: "Remove the custom domain and its verification (owner or admin). The page stops being served there at once. Returns 204.", zh: "移除自定义域名及其验证（需所有者或管理员），该域名立即停止提供此页面。返回 204。" },
      { m: "DELETE", p: "/status-pages/:id", en: "Delete a status page. Returns 204.", zh: "删除状态页。返回 204。" },
      { m: "GET", p: "/status-pages/:id/subscribers", en: "Workspace owners/admins only. Up to 1000 subscriber email addresses, newest first; other members receive 403.", zh: "仅工作区所有者或管理员可读取最多 1000 位订阅者的邮箱；其他成员返回 403。", res: `[{ id, email, confirmedAt, createdAt }]` },
      { m: "DELETE", p: "/status-pages/:id/subscribers/:sid", en: "Remove a subscriber. Returns 204.", zh: "移除订阅者。返回 204。" },
