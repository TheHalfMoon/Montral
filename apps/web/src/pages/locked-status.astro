---
export const prerender = false;
// Rendered in place of a password-protected status page (src/pages/status/[slug].astro rewrites here): it never
// receives the page's title or content, only the slug the visitor already typed.
// rendered byte-for-byte; its CSP hash is computed in astro.config.mjs
import unlockScript from "../inline/status-unlock.js?raw";
import Base from "../layouts/Base.astro";
import { translate } from "../lib/i18n";

const slug = Astro.url.searchParams.get("slug") ?? "";
if (!/^[a-z0-9-]{3,40}$/.test(slug)) return new Response("Not found", { status: 404, headers: { "cache-control": "private, no-store" } });
const t = (x: string) => translate(Astro.locals.lang ?? "en", x);
Astro.response.status = 401;
Astro.response.headers.set("cache-control", "private, no-store");
Astro.response.headers.set("referrer-policy", "no-referrer");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
---
<Base title={t("Password required")} noindex>
  <main class="lock-wrap">
    <section class="card lock-card">
      <h1>{t("This status page is password protected")}</h1>
      <p class="muted">{t("Enter the password you were given. Access lasts up to 12 hours on this browser.")}</p>
      <form id="unlock" data-slug={slug} data-wrong={t("That password is not right.")} data-slow={t("Too many attempts. Please try again later.")}>
        <label class="fld">{t("Password")}
          <input class="in" name="password" type="password" required minlength="1" maxlength="200" autocomplete="current-password" autofocus />
        </label>
        <button class="btn primary full">{t("Open status page")}</button>
        <p id="unlock-msg" class="err" role="alert" aria-live="polite"></p>
      </form>
      <p class="faint">{t("Have a share link instead? Open it directly; no password is needed.")}</p>
    </section>
  </main>
  <script is:inline set:html={unlockScript} />
</Base>
<style>
  .lock-wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px 16px; }
  .lock-card { width: 100%; max-width: 420px; display: grid; gap: 14px; padding: 28px; }
  .lock-card h1 { font-size: 22px; line-height: 1.3; margin: 0; }
  .lock-card form { display: grid; gap: 12px; }
  .lock-card .err:empty { display: none; }
</style>
