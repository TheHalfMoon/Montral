{
  "name": "montral",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:api": "pnpm --filter @montral/api dev",
    "dev:web": "pnpm --filter @montral/web dev",
    "db:generate": "pnpm --filter @montral/db-pg generate",
    "db:migrate": "pnpm --filter @montral/db-pg migrate",
    "typecheck": "pnpm -r typecheck"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheHalfMoon/Montral.git"
  },
  "homepage": "https://github.com/TheHalfMoon/Montral#readme",
  "bugs": {
    "url": "https://github.com/TheHalfMoon/Montral/issues"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
